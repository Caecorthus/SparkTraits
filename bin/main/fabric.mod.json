{
  "schemaVersion": 1,
  "id": "sparktraits",
  "version": "0.1.9.9",
  "name": "SparkTraits",
  "description": "Passive trait mechanics for Spark Wathe.",
  "authors": [
    "Caecorthus"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.caecorthus.sparktraits.SparkTraits"
    ],
    "client": [
      "dev.caecorthus.sparktraits.client.SparkTraitsClient"
    ],
    "cardinal-components": [
      "dev.caecorthus.sparktraits.component.SparkTraitsComponents"
    ],
    "voicechat": [
      "dev.caecorthus.sparktraits.voice.SparkTraitsVoiceChatPlugin"
    ]
  },
  "custom": {
    "cardinal-components": [
      "sparktraits:traits",
      "sparktraits:world"
    ]
  },
  "mixins": [
    "sparktraits.mixins.json",
    {
      "config": "sparktraits.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "fabric-api": "*",
    "minecraft": "1.21.1",
    "java": ">=21",
    "wathe": "1.5.7-spark-1.21.1",
    "noellesroles": "1.7.7-h1.5.7-spark",
    "sparkfactionapi": ">=0.1.5.9",
    "ratatouille": ">=1.4.3-1.21.1",
    "cardinal-components-base": ">=6.1.1",
    "cardinal-components-entity": ">=6.1.1",
    "cardinal-components-world": ">=6.1.1"
  }
}
